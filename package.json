{
  "name": "roadproof-route-analyzer",
  "version": "1.0.0",
  "description": "Evidence-first, multi-purpose European road-type and route composition analyzer.",
  "author": {
    "name": "Kiavash",
    "url": "https://github.com/kiavash599"
  },
  "homepage": "https://github.com/kiavash599/roadproof-route-analyzer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiavash599/roadproof-route-analyzer.git"
  },
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "desktop:smoke": "npm run build && node desktop/smoke.cjs",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "desktop:publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "electron-updater": "6.8.9",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "RoadProof",
  "build": {
    "appId": "com.kiavash599.roadproof",
    "productName": "RoadProof",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/client/**/*",
      "dist/server/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kiavash599",
        "repo": "roadproof-route-analyzer",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build-resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RoadProof",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build-resources/icon.png",
      "category": "public.app-category.navigation",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "pkg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "pkg": {
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": false
    }
  }
}
